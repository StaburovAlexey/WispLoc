// WispLoc — Prisma Schema
// Database file: ~/.wisploc/data/wisploc.db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // url is set via environment variable or at runtime
  url      = env("DATABASE_URL")
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SetupState {
  id             String   @id @default(uuid())
  setupCompleted Boolean  @default(false)
  status         String   @default("IDLE")
  currentStep    String?
  progress       Int      @default(0)
  ffmpegStatus   String   @default("missing")
  whisperStatus  String   @default("missing")
  modelStatus    String   @default("missing")
  ollamaStatus   String   @default("missing")
  llmStatus      String   @default("missing")
  errorMessage   String?
  logJson        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MediaFile {
  id           String   @id @default(uuid())
  originalName String
  mimeType     String
  sizeBytes    Int
  durationSec  Float?
  status       String   @default("UPLOADED")
  sourcePath   String
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chunks         MediaChunk[]
  jobs           ProcessingJob[]
  transcript     TranscriptSegment[]
  summaries      Summary[]
  extractedTasks ExtractedTask[]
  summaryBatchCheckpoints SummaryBatchCheckpoint[]
}

model MediaChunk {
  id             String   @id @default(uuid())
  mediaFileId    String
  index          Int
  startSec       Float
  endSec         Float
  audioPath      String
  status         String   @default("PENDING")
  transcriptPath String?
  summaryPath    String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@unique([mediaFileId, index])
}

model ProcessingJob {
  id           String   @id @default(uuid())
  mediaFileId  String?
  type         String
  status       String   @default("PENDING")
  progress     Int      @default(0)
  currentStep  String?
  attempts     Int      @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  pipelineVersion String  @default("legacy-v1")
  useDictionary   Boolean @default(false)
  discoverTerms   Boolean @default(false)
  stagesJson      String?
  requestedStagesJson String?
  inputHash       String?
  promptVersion   String?
  modelName       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mediaFile MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
}

model TranscriptSegment {
  id          String   @id @default(uuid())
  mediaFileId String
  chunkId     String?
  startSec    Float
  endSec      Float
  text        String
  normalizedText String?
  sequence    Int      @default(0)
  replacementsJson String?
  speaker     String?
  createdAt   DateTime @default(now())

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
}

model Summary {
  id               String   @id @default(uuid())
  mediaFileId      String
  kind             String
  shortSummary     String?
  detailedSummary  String?
  keyPointsJson    String?
  decisionsJson    String?
  risksJson        String?
  openQuestionsJson String?
  actionItemsJson  String?
  modelName        String
  pipelineVersion  String   @default("legacy-v1")
  promptVersion    String?
  sourceItemsJson  String?
  problemsJson     String?
  proposalsJson    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
}

model ExtractedTask {
  id               String   @id @default(uuid())
  mediaFileId      String
  title            String
  description      String
  sourceTimecode   String?
  sourceChunkIndex Int?
  priority         String?
  labelsJson       String?
  assigneeHint     String?
  dueDateHint      String?
  confidence       Float?
  status           String   @default("DRAFT")
  pipelineVersion  String   @default("legacy-v1")
  modelName        String?
  promptVersion    String?
  sourceFactIdsJson String?
  evidenceJson     String?
  mergedCandidateIdsJson String?
  generatedTitle   String?
  generatedDescription String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mediaFile     MediaFile            @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  externalTasks CreatedExternalTask[]
}

model DictionaryEntry {
  id              String   @id @default(uuid())
  canonical       String
  aliasesJson     String
  status          String   @default("ACTIVE")
  confirmedByUser Boolean  @default(true)
  usageCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EvidenceTranscriptChunk {
  id              String   @id @default(uuid())
  mediaFileId     String
  processingJobId String
  index           Int
  startSec        Float
  endSec          Float
  segmentIdsJson  String
  originalText    String
  normalizedText  String
  inputHash       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([processingJobId, index])
}

model AtomicFactRecord {
  id                   String   @id
  mediaFileId          String
  processingJobId      String
  chunkIndex           Int
  type                 String
  text                 String
  evidenceQuote        String
  startSec             Float
  endSec               Float
  speaker              String?
  explicit             Boolean
  validationStatus     String
  validationErrorsJson String
  repairUsed           Boolean  @default(false)
  promptVersion        String
  modelName            String
  createdAt            DateTime @default(now())
}

model MergedFactRecord {
  id                String   @id
  mediaFileId       String
  processingJobId   String
  type              String
  text              String
  evidenceJson      String
  sourceFactIdsJson String
  createdAt         DateTime @default(now())
}

model SummaryBatchCheckpoint {
  id            String   @id @default(uuid())
  mediaFileId   String
  batchIndex    Int
  inputHash     String
  summaryJson   String
  modelName     String
  promptVersion String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@unique([mediaFileId, batchIndex, inputHash])
}

model TaskCandidateRecord {
  id                     String   @id
  mediaFileId            String
  processingJobId        String
  title                  String
  description            String?
  assignee               String?
  dueDate                String?
  priority               String?
  sourceFactIdsJson      String
  evidenceJson           String
  explicitAction         Boolean
  explicitAssignee       Boolean
  explicitDueDate        Boolean
  mergedCandidateIdsJson String?
  createdAt              DateTime @default(now())
}

model TermSuggestion {
  id                String   @id @default(uuid())
  mediaFileId       String
  processingJobId   String
  observedForm      String
  proposedCanonical String
  aliasesJson       String
  occurrenceCount   Int
  examplesJson      String
  status            String   @default("PROPOSED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model IntegrationAccount {
  id             String   @id @default(uuid())
  provider       String
  displayName    String
  baseUrl        String?
  authType       String
  encryptedToken String
  organizationId String?
  isEnabled      Boolean  @default(true)
  settingsJson   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  targets IntegrationTarget[]
}

model IntegrationTarget {
  id            String   @id @default(uuid())
  integrationId String
  externalId    String
  key           String?
  name          String
  type          String
  settingsJson  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration IntegrationAccount @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model CreatedExternalTask {
  id              String   @id @default(uuid())
  extractedTaskId String
  provider        String
  integrationId   String?
  externalId      String
  externalKey     String?
  externalUrl     String
  status          String
  errorMessage    String?
  createdAt       DateTime @default(now())

  extractedTask ExtractedTask @relation(fields: [extractedTaskId], references: [id], onDelete: Cascade)
}

// WispLoc — Prisma Schema
// Database file: ~/.wisploc/data/wisploc.db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // url is set via environment variable or at runtime
  url      = env("DATABASE_URL")
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SetupState {
  id             String   @id @default(uuid())
  setupCompleted Boolean  @default(false)
  status         String   @default("IDLE")
  currentStep    String?
  progress       Int      @default(0)
  ffmpegStatus   String   @default("missing")
  whisperStatus  String   @default("missing")
  modelStatus    String   @default("missing")
  ollamaStatus   String   @default("missing")
  llmStatus      String   @default("missing")
  errorMessage   String?
  logJson        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MediaFile {
  id           String   @id @default(uuid())
  originalName String
  mimeType     String
  sizeBytes    Int
  durationSec  Float?
  status       String   @default("UPLOADED")
  sourcePath   String
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chunks         MediaChunk[]
  jobs           ProcessingJob[]
  transcript     TranscriptSegment[]
  summaries      Summary[]
  extractedTasks ExtractedTask[]
}

model MediaChunk {
  id             String   @id @default(uuid())
  mediaFileId    String
  index          Int
  startSec       Float
  endSec         Float
  audioPath      String
  status         String   @default("PENDING")
  transcriptPath String?
  summaryPath    String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@unique([mediaFileId, index])
}

model ProcessingJob {
  id           String   @id @default(uuid())
  mediaFileId  String?
  type         String
  status       String   @default("PENDING")
  progress     Int      @default(0)
  currentStep  String?
  attempts     Int      @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mediaFile MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
}

model TranscriptSegment {
  id          String   @id @default(uuid())
  mediaFileId String
  chunkId     String?
  startSec    Float
  endSec      Float
  text        String
  speaker     String?
  createdAt   DateTime @default(now())

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
}

model Summary {
  id               String   @id @default(uuid())
  mediaFileId      String
  kind             String
  shortSummary     String?
  detailedSummary  String?
  keyPointsJson    String?
  decisionsJson    String?
  risksJson        String?
  openQuestionsJson String?
  actionItemsJson  String?
  modelName        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
}

model ExtractedTask {
  id               String   @id @default(uuid())
  mediaFileId      String
  title            String
  description      String
  sourceTimecode   String?
  sourceChunkIndex Int?
  priority         String?
  labelsJson       String?
  assigneeHint     String?
  dueDateHint      String?
  confidence       Float?
  status           String   @default("DRAFT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mediaFile     MediaFile            @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  externalTasks CreatedExternalTask[]
}

model IntegrationAccount {
  id             String   @id @default(uuid())
  provider       String
  displayName    String
  baseUrl        String?
  authType       String
  encryptedToken String
  organizationId String?
  isEnabled      Boolean  @default(true)
  settingsJson   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  targets IntegrationTarget[]
}

model IntegrationTarget {
  id            String   @id @default(uuid())
  integrationId String
  externalId    String
  key           String?
  name          String
  type          String
  settingsJson  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration IntegrationAccount @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model CreatedExternalTask {
  id              String   @id @default(uuid())
  extractedTaskId String
  provider        String
  integrationId   String?
  externalId      String
  externalKey     String?
  externalUrl     String
  status          String
  errorMessage    String?
  createdAt       DateTime @default(now())

  extractedTask ExtractedTask @relation(fields: [extractedTaskId], references: [id], onDelete: Cascade)
}
